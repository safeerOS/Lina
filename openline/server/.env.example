PORT=8787
# Prazno = samo 127.0.0.1. Izrecni HOST sme biti samo zasebni naslov ali localhost
# (ne 0.0.0.0, ne javni IP).
# HOST=192.168.1.20
# Dolg nakljucen skrivnost za API in konzolo. Obvezen, vsaj 32 znakov, ne "change-me".
HTTP_GATEWAY_API_KEY=change-me

# Javni https naslov. Prazno = https://<HOST>:<PORT>. Certifikat je samopodpisan;
# odtis SHA-256 se izpise ob zagonu in gre v kodo QR.
# PUBLIC_URL=https://192.168.1.20:8787

# Gemini je izklopljen. Dohodni zvok gre na Lino, ce je nastavljen zeton.
# Zeton gre v glavo Authorization, ne v URL in ne v bazo.
LINA_STREAM_URL=wss://127.0.0.1:8080/api/voice/stream
LINA_STREAM_TOKEN=
# Odtis SHA-256 samopodpisanega certifikata Line (brez dvopicij). Brez njega se povezava ne odpre.
LINA_CERT_SHA256=
# on (privzeto) = samo stevilke s seznama. off = vse dohodne, tudi neznane in skrite.
# Stevilke v sili se ne prevzamejo nikoli. Pred stikalom ostanejo tudi samo dohodni,
# rocno sprejeti in uporabnikov drug klic (to preveri telefon).
# LINA_ALLOWLIST_MODE=on
# Vejica ali nova vrstica. Ob nacinu on prazen seznam = noben dohodni klic.
LINA_ALLOWLIST=

# Mapa SQLite baze (gateway.db) in samopodpisanega certifikata (tls/).
DATA_DIR=data

# AGENT_OWNER_NAME se ne uporablja (Gemini je izklopljen).
# AGENT_OWNER_NAME=Your Name

# Neobvezno: kam kaze povezava Docs v konzoli.
# DOCS_URL=https://docs.example.com

# Neobvezno: privzeti webhook za dogodke klicev (samo https, samo zasebni naslov ali localhost).
# WEBHOOK_URL=https://192.168.1.20/http-gateway/events
