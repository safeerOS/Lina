<?xml version="1.0" encoding="utf-8"?>
<!-- Golo HTTP je izklopljeno. Samopodpisani certifikat se pripne v OkHttp, ne prek uporabniskih CA. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
