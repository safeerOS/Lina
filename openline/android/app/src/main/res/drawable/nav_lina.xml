<?xml version="1.0" encoding="utf-8"?>
<!-- Sredinski gumb Lina (Mobile 2.0): vijolicni prelivi, izbran dobi turkizen rob. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <gradient android:angle="315" android:startColor="#8B5CF6" android:endColor="#5B3FD1" />
                    <stroke android:width="2dp" android:color="@color/accent" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="315" android:startColor="#6D45D9" android:endColor="#47318F" />
                    <stroke android:width="1dp" android:color="@color/line" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
