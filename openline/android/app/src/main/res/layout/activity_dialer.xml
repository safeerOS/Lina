<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- Header: what this phone is and whether it is online -->
        <TextView
            style="@style/Gw.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/connectionDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/connectionText"
                style="@style/Gw.Muted"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Setup: a real sequence, so the steps are numbered -->
        <LinearLayout
            style="@style/Gw.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp">

            <TextView
                style="@style/Gw.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_title" />

            <include
                android:id="@+id/stepRole"
                layout="@layout/item_setup_step" />

            <include
                android:id="@+id/stepServer"
                layout="@layout/item_setup_step" />

            <include
                android:id="@+id/stepAudio"
                layout="@layout/item_setup_step" />

            <include
                android:id="@+id/stepBattery"
                layout="@layout/item_setup_step" />
        </LinearLayout>

        <!-- Lina: cas zvonjenja, seznam in ustavitev lupine -->
        <LinearLayout
            style="@style/Gw.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                style="@style/Gw.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lina_heading" />

            <TextView
                style="@style/Gw.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/language" />

            <Spinner
                android:id="@+id/languageSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <TextView
                style="@style/Gw.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ring_timeout_label" />

            <EditText
                android:id="@+id/ringTimeoutInput"
                style="@style/Gw.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAutofill="no"
                android:inputType="number"
                android:text="20" />

            <TextView
                style="@style/Gw.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/allowlist_label" />

            <EditText
                android:id="@+id/allowlistInput"
                style="@style/Gw.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="top"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|phone"
                android:minLines="3" />

            <CheckBox
                android:id="@+id/allowlistEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="@string/allowlist_switch" />

            <Button
                android:id="@+id/saveLinaButton"
                style="@style/Gw.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/save_lina" />

            <Button
                android:id="@+id/stopCleanButton"
                style="@style/Gw.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/stop_clean" />
        </LinearLayout>

        <!-- Dial -->
        <LinearLayout
            style="@style/Gw.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                style="@style/Gw.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/call_from_phone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/numberInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/dial_underline"
                    android:hint="@string/number_hint"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:paddingTop="6dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/hint"
                    android:textFontWeight="600"
                    android:textSize="30sp" />

                <Button
                    android:id="@+id/callButton"
                    style="@style/Gw.Button.Solid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/call" />
            </LinearLayout>
        </LinearLayout>

        <!-- Advanced: manual connection, rarely needed after QR pairing -->
        <TextView
            android:id="@+id/advancedToggle"
            style="@style/Gw.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/show_advanced"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/advanced"
            style="@style/Gw.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <TextView
                style="@style/Gw.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/server_address" />

            <EditText
                android:id="@+id/wsUrlInput"
                style="@style/Gw.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/server_address_hint"
                android:importantForAutofill="no"
                android:inputType="textUri" />

            <TextView
                style="@style/Gw.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/phone_id" />

            <EditText
                android:id="@+id/deviceIdInput"
                style="@style/Gw.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAutofill="no"
                android:inputType="text" />

            <TextView
                style="@style/Gw.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/phone_token" />

            <EditText
                android:id="@+id/deviceTokenInput"
                style="@style/Gw.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <TextView
                style="@style/Gw.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cert_fingerprint" />

            <EditText
                android:id="@+id/certInput"
                style="@style/Gw.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAutofill="no"
                android:inputType="text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/saveConfigButton"
                    style="@style/Gw.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/save_reconnect" />

                <Button
                    android:id="@+id/restartAudioButton"
                    style="@style/Gw.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/restart_audio" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
