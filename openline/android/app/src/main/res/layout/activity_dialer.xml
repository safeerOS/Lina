<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<ScrollView
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- Header: what this phone is and whether it is online -->
        <TextView
            style="@style/Gw.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/connectionDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/connectionText"
                style="@style/Gw.Muted"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabCalls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <!-- Klicalnik po vzoru aplikacije Telefon (lastnik 18. 11. 2026): iskanje po imenu, stevilka, okrogle tipke, zeleni gumb. -->
            <LinearLayout
                style="@style/Gw.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <TextView
                    style="@style/Gw.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/call_from_phone" />

                <EditText
                    android:id="@+id/contactQuery"
                    style="@style/Gw.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:drawablePadding="8dp"
                    android:hint="@string/contact_search_hint"
                    android:importantForAutofill="no"
                    android:imeOptions="actionSearch"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1"
                    android:textColorHint="@color/hint" />

                <TextView
                    android:id="@+id/contactsAllow"
                    style="@style/Gw.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:text="@string/contacts_allow"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/contactResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- Stevilka: velika, na sredini; sistemska tipkovnica se tu ne odpira (tipke spodaj). -->
                <EditText
                    android:id="@+id/numberInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@null"
                    android:gravity="center"
                    android:hint="@string/number_hint"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/hint"
                    android:textFontWeight="500"
                    android:textSize="32sp" />

                <GridLayout
                    android:id="@+id/dialPad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:columnCount="3" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/callButton"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/btn_call_round"
                        android:contentDescription="@string/call"
                        android:src="@drawable/ic_call" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1">

                        <Button
                            android:id="@+id/backspaceButton"
                            style="@style/Gw.Button"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:background="@drawable/key_round"
                            android:contentDescription="@string/dial_backspace"
                            android:padding="0dp"
                            android:text="⌫"
                            android:textSize="22sp" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Setup: a real sequence, so the steps are numbered -->
            <LinearLayout
                style="@style/Gw.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:paddingTop="16dp"
                android:paddingBottom="4dp">

                <TextView
                    style="@style/Gw.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_title" />

                <include
                    android:id="@+id/stepRole"
                    layout="@layout/item_setup_step" />

                <include
                    android:id="@+id/stepServer"
                    layout="@layout/item_setup_step" />

                <include
                    android:id="@+id/stepAudio"
                    layout="@layout/item_setup_step" />

                <include
                    android:id="@+id/stepBattery"
                    layout="@layout/item_setup_step" />
            </LinearLayout>

            <!-- Advanced: manual connection, rarely needed after QR pairing -->
            <TextView
                android:id="@+id/advancedToggle"
                style="@style/Gw.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/show_advanced"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/advanced"
                style="@style/Gw.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <TextView
                    style="@style/Gw.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/server_address" />

                <EditText
                    android:id="@+id/wsUrlInput"
                    style="@style/Gw.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="@string/server_address_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri" />

                <TextView
                    style="@style/Gw.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/phone_id" />

                <EditText
                    android:id="@+id/deviceIdInput"
                    style="@style/Gw.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:importantForAutofill="no"
                    android:inputType="text" />

                <TextView
                    style="@style/Gw.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/phone_token" />

                <EditText
                    android:id="@+id/deviceTokenInput"
                    style="@style/Gw.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:importantForAutofill="no"
                    android:inputType="textPassword" />

                <TextView
                    style="@style/Gw.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/cert_fingerprint" />

                <EditText
                    android:id="@+id/certInput"
                    style="@style/Gw.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:importantForAutofill="no"
                    android:inputType="text" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/saveConfigButton"
                        style="@style/Gw.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/save_reconnect" />

                    <Button
                        android:id="@+id/restartAudioButton"
                        style="@style/Gw.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/restart_audio" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabLina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Lina: cas zvonjenja, seznam in ustavitev lupine -->
            <LinearLayout
                style="@style/Gw.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp">

                <TextView
                    style="@style/Gw.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lina_heading" />

                <TextView
                    style="@style/Gw.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/language" />

                <Spinner
                    android:id="@+id/languageSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <TextView
                    style="@style/Gw.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:labelFor="@+id/ringTimeoutInput"
                    android:text="@string/ring_timeout_label" />

                <EditText
                    android:id="@+id/ringTimeoutInput"
                    style="@style/Gw.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:importantForAutofill="no"
                    android:inputType="number" />

                <TextView
                    style="@style/Gw.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:labelFor="@+id/allowlistInput"
                    android:text="@string/allowlist_label" />

                <EditText
                    android:id="@+id/allowlistInput"
                    style="@style/Gw.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="top"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|phone"
                    android:minLines="3" />

                <CheckBox
                    android:id="@+id/allowlistEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="true"
                    android:text="@string/allowlist_switch" />

                <TextView
                    style="@style/Gw.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/line_label" />

                <TextView
                    android:id="@+id/lineStatus"
                    style="@style/Gw.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/linePermissionButton"
                    style="@style/Gw.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/line_permission_button"
                    android:visibility="gone" />

                <Spinner
                    android:id="@+id/lineSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:contentDescription="@string/line_label"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/saveLinaButton"
                    style="@style/Gw.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/save_lina" />

                <Button
                    android:id="@+id/stopCleanButton"
                    style="@style/Gw.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/stop_clean" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabAssistant"
            style="@style/Gw.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                style="@style/Gw.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/assistant_title" />

            <!-- Samostojna asistentka: deluje brez racunalnika (lastnik 18. 11. 2026). -->
            <TextView
                android:id="@+id/assistantLocalInfo"
                style="@style/Gw.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/assistantProviderLabel"
                style="@style/Gw.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/local_provider" />

            <LinearLayout
                android:id="@+id/assistantProviderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/assistantKeyBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/assistantKeyInput"
                    style="@style/Gw.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint=""
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:maxLength="200" />

                <Button
                    android:id="@+id/assistantKeySave"
                    style="@style/Gw.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/local_key_save" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/assistantGoogleBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/assistantGoogleInfo"
                    style="@style/Gw.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/local_google_info" />

                <Button
                    android:id="@+id/assistantGoogleSignIn"
                    style="@style/Gw.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/local_google_sign_in" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/assistantChatBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/assistantChatLog"
                    style="@style/Gw.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="true"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/assistantChatInput"
                    style="@style/Gw.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="top"
                    android:hint="@string/local_chat_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:maxLength="4000"
                    android:minLines="2" />

                <Button
                    android:id="@+id/assistantChatSend"
                    style="@style/Gw.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/local_send" />
            </LinearLayout>

            <TextView
                android:id="@+id/assistantNotesTitle"
                style="@style/Gw.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/local_notes_title"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/assistantNotesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/assistantKeyForget"
                style="@style/Gw.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/local_key_forget"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabComputer"
            style="@style/Gw.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                style="@style/Gw.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/assistant_computer_title" />

            <TextView
                android:id="@+id/assistantStatus"
                style="@style/Gw.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/assistantDeviceId"
                style="@style/Gw.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/assistantPairButton"
                style="@style/Gw.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/scan_qr"
                android:visibility="gone" />

            <Button
                android:id="@+id/assistantCircleButton"
                style="@style/Gw.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/circle_confirm"
                android:visibility="gone" />

            <Button
                android:id="@+id/assistantCodeButton"
                style="@style/Gw.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/assistant_code_button"
                android:visibility="gone" />

            <TextView
                android:id="@+id/assistantLog"
                style="@style/Gw.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/assistantApproval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Gw.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/assistant_approval_title" />

                <TextView
                    android:id="@+id/assistantApprovalTool"
                    style="@style/Gw.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <TextView
                    style="@style/Gw.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:labelFor="@+id/assistantApprovalPreview"
                    android:text="@string/assistant_approval_preview" />

                <TextView
                    android:id="@+id/assistantApprovalPreview"
                    style="@style/Gw.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true" />

                <TextView
                    style="@style/Gw.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:labelFor="@+id/assistantApprovalDescription"
                    android:text="@string/assistant_approval_desc" />

                <TextView
                    android:id="@+id/assistantApprovalDescription"
                    style="@style/Gw.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/assistantAllowButton"
                        style="@style/Gw.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/assistant_allow" />

                    <Button
                        android:id="@+id/assistantDenyButton"
                        style="@style/Gw.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/assistant_deny" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/assistantStopButton"
                style="@style/Gw.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/assistant_stop"
                android:visibility="gone" />

            <!-- Vnos in gumb samo, ko je telefon seznanjen in nobena naloga ne tece (AsistentPrikaz). -->
            <EditText
                android:id="@+id/assistantTaskInput"
                style="@style/Gw.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="top"
                android:hint="@string/assistant_task_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLength="4000"
                android:minLines="3"
                android:visibility="gone" />

            <Button
                android:id="@+id/assistantSendButton"
                style="@style/Gw.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/assistant_send"
                android:visibility="gone" />

            <Button
                android:id="@+id/assistantForgetButton"
                style="@style/Gw.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/assistant_forget"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
<!-- Spodnja navigacija: pet podmenijev namesto enega dolgega zaslona (lastnik 18. 11. 2026). -->
<LinearLayout
    android:id="@+id/navBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="horizontal">
        <Button
            android:id="@+id/navCalls"
