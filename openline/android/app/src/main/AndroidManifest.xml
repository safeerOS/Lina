<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lina deluje tudi na napravi brez telefonije (zavihek Asistent, tablica); prevzem klicev takrat ni na voljo. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Namesti na ta telefon (24. 11. 2026): posodobitev Line iz gradnje na racunalniku; sistemsko okno potrdi lastnik. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Potrditev v ozji krog z enim dotikom: okno Safeer Phone/OS je zasciteno z dovoljenjem ravni signature. Lina dovoljenja
         samo UPORABLJA, ga NE definira (T4-2: dvojna definicija z drugim certifikatom zlomi namestitev); definira ga Safeer.
         Novo dovoljenje OZJI_KROG (Safeer 4fdcde94, T4-1): LINK Lina namenoma NE napove - z njim bi dosegla LinkSorodnikStoritev in SpletnePonudnik.
         Deluje samo, ce sta obe podpisani s kljucem Safeer (release prek orodja podpisi-apk.sh, ne v build.gradle.kts). -->
    <uses-permission android:name="si.safeer.tv.permission.OZJI_KROG" />
    <!-- Android 11+: vidnost paketov Safeer za potrditev v ozji krog (samo ta tri imena). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <package android:name="si.safeer.phone" />
        <package android:name="si.safeer.os" />
        <package android:name="si.safeer.tablet" />
        <!-- Samsungove Moje datoteke: gumb »Odpri mapo« (Android 11+ skrije pakete brez te vrstice). -->
        <package android:name="com.sec.android.app.myfiles" />
    </queries>
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Lastnik 18. 11. 2026: klicalnik Line mora iskati po imeniku (dovoljenje potrdi uporabnik sam). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Lastnik 24. 11. 2026: asistentka sama zajame govor z zmanjsanjem hrupa (stikalo »Zmanjsanje hrupa«); dovoljenje ob prvem dotiku mikrofona, brez njega sistemska prepoznava. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Budilka v aplikaciji Ura po uporabnikovi potrditvi (AlarmClock.ACTION_SET_ALARM). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Sistemski nadzor (24. 11. 2026): nacin »ne moti« (uporabnik dovoli v Posebni dostop aplikacij) in svetlost zaslona
         (Spreminjanje sistemskih nastavitev); oba samo po uporabnikovi potrditvi v aplikaciji. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- N14-4: celozaslonsko obvestilo dohodnega klica (klicalnik); brez njega bi se klic ob zaklenjenem zaslonu ne dal dvigniti. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Opomniki ob dolocenem casu (2j): natancen alarm; brez dovoljenja se opomnik sprozi priblizno. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Povezava do streznika v ozadju. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".GatewayApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.HttpGateway"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".InCallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity
            android:name=".DialerActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Vrnitev prijave z Google (OAuth PKCE): shema je ID odjemalca Android, glej GoogleOAuth. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.googleusercontent.apps.292650165087-vqd78tu81h2o55i9vfa3uobs64m58hv4" android:path="/oauth2redirect" />
            </intent-filter>

            <!-- ACTION_DIAL without a URI must resolve to the default dialer. -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- tel: ACTION_DIAL, da je aplikacija lahko privzeti klicnik. -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>

            <!-- Lina kot cilj »Deli« (24. 11. 2026): datoteke gredo med priponke Pogovora, poslje jih lastnik s tapom Poslji.
                 Vrste enako kot sprejemljivaVrstaDeljenja (samostojna/Deljenje.kt); stikalo v Nastavitvah > Orodja. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Gumb »Fotografiraj«: program za fotografiranje zapise eno sliko v cacheDir (zacasno dovoljenje iz namena, brez CAMERA). -->
        <provider
            android:name=".asistent.PosnetekPonudnik"
            android:authorities="${applicationId}.posnetek"
            android:exported="false"
            android:grantUriPermissions="true" />


        <receiver
            android:name=".telecom.IncomingCallActionReceiver"
            android:exported="false" />

        <!-- Izid seje PackageInstaller (ekspliciten PendingIntent, neizvozen). -->
        <receiver
            android:name=".asistent.IzidNamestitve"
            android:exported="false" />

        <service
            android:name=".telecom.GatewayInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
        </service>
        <service
            android:name=".telecom.TipkaSlusalkStoritev"
            android:exported="true"
            android:label="@string/headset_key_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/tipka_slusalk_storitev" />
        </service>

        <!-- Naloga 28: periodicna preverba izdaje Line na GitHubu (JobScheduler, samo branje; namesti sele lastnik). -->
        <service
            android:name=".asistent.PosodobitevNaloga"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".shell.PairingService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <service
            android:name=".transport.GatewayConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a persistent connection to the user's self-hosted call gateway so calls can be placed and answered remotely." />
        </service>

        <receiver
            android:name=".asistent.OpomnikPrejemnik"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".shell.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Prosojna plast predloge cez fotografijo majice (23. 11. 2026); odpre se samo iz Nastavitev > Orodja. -->
        <activity
            android:name=".asistent.ProsojnaPlastActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

    </application>

</manifest>
