<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lina deluje tudi na napravi brez telefonije (zavihek Asistent, tablica); prevzem klicev takrat ni na voljo. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Potrditev v ozji krog z enim dotikom: okno Safeer Phone/OS je zasciteno z dovoljenjem ravni signature. Lina dovoljenja
         samo UPORABLJA, ga NE definira (T4-2: dvojna definicija z drugim certifikatom zlomi namestitev); definira ga Safeer.
         Novo dovoljenje OZJI_KROG (Safeer 4fdcde94, T4-1): LINK Lina namenoma NE napove - z njim bi dosegla LinkSorodnikStoritev in SpletnePonudnik.
         Deluje samo, ce sta obe podpisani s kljucem Safeer (release prek orodja podpisi-apk.sh, ne v build.gradle.kts). -->
    <uses-permission android:name="si.safeer.tv.permission.OZJI_KROG" />
    <!-- Android 11+: vidnost paketov Safeer za potrditev v ozji krog (samo ta tri imena). -->
    <queries>
        <package android:name="si.safeer.phone" />
        <package android:name="si.safeer.os" />
        <package android:name="si.safeer.tablet" />
    </queries>
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- N14-4: celozaslonsko obvestilo dohodnega klica (klicalnik); brez njega bi se klic ob zaklenjenem zaslonu ne dal dvigniti. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Povezava do streznika v ozadju. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".GatewayApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.HttpGateway"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".InCallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity
            android:name=".DialerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ACTION_DIAL without a URI must resolve to the default dialer. -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- tel: ACTION_DIAL, da je aplikacija lahko privzeti klicnik. -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>


        <receiver
            android:name=".telecom.IncomingCallActionReceiver"
            android:exported="false" />

        <service
            android:name=".telecom.GatewayInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
        </service>
        <service
            android:name=".shell.PairingService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <service
            android:name=".transport.GatewayConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a persistent connection to the user's self-hosted call gateway so calls can be placed and answered remotely." />
        </service>

        <receiver
            android:name=".shell.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
